{
  "name": "wechat-ai-autoreply",
  "productName": "微信AI自动回复",
  "version": "2.0.0",
  "description": "基于视觉感知与 Win32 无痕挂载的 PC 微信 AI 自动回复 —— Electron 控制中心",
  "author": {
    "name": "Luofeng-Cloud"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:python": "python -m pytest tests -q",
    "test:node": "node --test dist/tests/*.test.js",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:engine": "pyinstaller --noconfirm --clean build/engine.spec",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "electron-vite build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {}
}
